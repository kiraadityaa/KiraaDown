# KiraaDown - environment variables (semua opsional, tetap Rp0 tanpa kartu kredit)
# Salin file ini menjadi .env.local untuk pengembangan lokal.

# Basis API TikWM gratis (tanpa kunci). Default: https://www.tikwm.com
TIKWM_API_BASE=https://www.tikwm.com

# Basis worker cadangan gratis (tanpa kunci). Default: https://tdownv4.sl-bjs.workers.dev
WORKER_API_BASE=https://tdownv4.sl-bjs.workers.dev

# Rate limit resolve per IP per menit (default 12, maks 60)
RATE_LIMIT_PER_MIN=12
